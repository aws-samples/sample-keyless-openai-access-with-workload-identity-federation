# Copy to config.env and fill in. config.env is git-ignored: it holds your Okta API token.
AWS_PROFILE=
AWS_REGION=us-east-1
# Optional: the scripts refuse to run if AWS_PROFILE is a different account.
AWS_ACCOUNT_ID=

# --- Okta (an org with Okta for AI Agents; admin API token from Security > API > Tokens) ---
OKTA_DOMAIN=https://your-org.okta.com
OKTA_API_TOKEN=
OKTA_ENGINEERING_USERS=ada.lovelace@example.com
OKTA_FINANCE_USERS=grace.hopper@example.com
# Optional: the name of an existing Okta app sign-in policy to attach to the agent's sign-in app.
OKTA_APP_SIGNON_POLICY=

# --- OpenAI (from the OpenAI dashboard: workload identity provider + one service account per team project) ---
OPENAI_IDENTITY_PROVIDER_ID=
OPENAI_SA_ENGINEERING=
OPENAI_SA_FINANCE=
